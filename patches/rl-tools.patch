new file mode 100644
index 00000000..dc374901
--- /dev/null
+++ b/include/rl_tools/containers/matrix/operations_arm/opt.h
@@ -0,0 +1,80 @@
+#include "../../../version.h"
+#if (defined(RL_TOOLS_DISABLE_INCLUDE_GUARDS) || !defined(RL_TOOLS_CONTAINERS_MATRIX_OPERATIONS_ARM_OPT_H)) && (RL_TOOLS_USE_THIS_VERSION == 1)
+#pragma once
+#define RL_TOOLS_CONTAINERS_MATRIX_OPERATIONS_ARM_OPT_H
+
+#include "../../../containers/matrix/operations_generic.h"
+#include "../../../devices/arm.h"
+
+RL_TOOLS_NAMESPACE_WRAPPER_START
+namespace rl_tools{
+    // Fast replacement for the generic get()/set()-per-element matrix_multiply_accumulate
+    // (containers/matrix/operations_generic.h), mirroring the pointer-walk/unroll approach
+    // already used for dense layers (nn/layers/dense/operations_arm/opt.h).
+    //
+    // Restricted (via static_assert, not a silent fallback) to the memory layout that
+    // nn::layers::gru::helper::matrix_multiply_transpose_bias(_accumulate) actually produces:
+    //   A: contraction dimension contiguous (COL_PITCH == 1)   -- e.g. an input/state row
+    //   B: contraction dimension contiguous (ROW_PITCH == 1)   -- e.g. a weight matrix permuted/transposed
+    //      into a [K x N] view, where walking the original weight row (a fixed output unit's
+    //      weights) is a stride-1 walk
+    //   output: COL_PITCH == 1, pre-populated with the bias (accumulated onto, not overwritten)
+    template<typename DEV_SPEC, typename SPEC_1, typename SPEC_2, typename SPEC_OUT>
+    void multiply_accumulate(devices::arm::OPT<DEV_SPEC>& device, const Matrix<SPEC_1>& A, const Matrix<SPEC_2>& B, Matrix<SPEC_OUT>& output){
+        static_assert(SPEC_1::COL_PITCH == 1, "ARM fast path requires A's contraction dimension to be contiguous");
+        static_assert(SPEC_2::ROW_PITCH == 1, "ARM fast path requires B's contraction dimension to be contiguous");
+        static_assert(SPEC_OUT::COL_PITCH == 1, "ARM fast path requires output's column dimension to be contiguous");
+        static_assert(SPEC_1::COLS == SPEC_2::ROWS, "contraction dimension mismatch");
+        static_assert(SPEC_1::ROWS == SPEC_OUT::ROWS);
+        static_assert(SPEC_2::COLS == SPEC_OUT::COLS);
+
+        using T = typename SPEC_1::T;
+        using TI = typename SPEC_1::TI;
+
+        constexpr TI ROWS = SPEC_OUT::ROWS; // batch size
+        constexpr TI COLS = SPEC_OUT::COLS; // output width (e.g. 3*HIDDEN_DIM)
+        constexpr TI K    = SPEC_1::COLS;   // contraction dim (e.g. INPUT_DIM / HIDDEN_DIM)
+
+        const T *a_row = A._data;
+        T *out_row = output._data;
+
+        TI row_i = ROWS;
+        while(row_i > 0U){
+            const T *b_col = B._data;
+            T *out_element = out_row;
+
+            TI col_i = COLS;
+            while(col_i > 0U){
+                const T *a_element = a_row;
+                const T *b_element = b_col;
+                T acc = *out_element; // pre-populated with bias by the caller
+
+                TI k = K >> 2U;
+                while(k > 0U){
+                    acc += a_element[0] * b_element[0];
+                    acc += a_element[1] * b_element[1];
+                    acc += a_element[2] * b_element[2];
+                    acc += a_element[3] * b_element[3];
+                    a_element += 4;
+                    b_element += 4;
+                    k--;
+                }
+                TI k_remainder = K % 0x4U;
+                while(k_remainder > 0U){
+                    acc += *a_element++ * *b_element++;
+                    k_remainder--;
+                }
+
+                *out_element++ = acc;
+                b_col += SPEC_2::COL_PITCH;
+                col_i--;
+            }
+            a_row += SPEC_1::ROW_PITCH;
+            out_row += SPEC_OUT::ROW_PITCH;
+            row_i--;
+        }
+    }
+}
+RL_TOOLS_NAMESPACE_WRAPPER_END
+
+#endif
