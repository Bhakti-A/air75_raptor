+        template<typename DEVICE, typename SPEC, typename STATE_SPEC, typename OBS_SPEC>
+        RL_TOOLS_FUNCTION_PLACEMENT static void _observe_external_pose(DEVICE& device, const Multirotor<SPEC>& env, const StateExternalPose<STATE_SPEC>& state, bool velocity, Matrix<OBS_SPEC>& observation){
