+        template<typename DEVICE, typename STATE_SPEC>
+        RL_TOOLS_FUNCTION_PLACEMENT static typename DEVICE::index_t _external_pose_slot(DEVICE& device, const StateExternalPose<STATE_SPEC>& state){
+            // the radio passes a new value every RADIO_PERIOD steps; that value is `delay` steps old when it is sent
+            using TI = typename DEVICE::index_t;
+            using STATE = StateExternalPose<STATE_SPEC>;
+            using CONFIG = typename STATE::CONFIG;
+            TI age = state.delay + (state.step + state.radio_phase) % CONFIG::RADIO_PERIOD;
+            static_assert(CONFIG::DELAY_MAX + CONFIG::RADIO_PERIOD - 1 < STATE::HISTORY_LENGTH);
+            return (state.step + STATE::HISTORY_LENGTH - age) % STATE::HISTORY_LENGTH; // slots before step 0 hold the initial value
