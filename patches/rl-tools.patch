+    static constexpr bool EXTERNAL_POSE_PREDICT_ACCEL = true;
+    static constexpr bool EXTERNAL_POSE_ACCEL_REAL = false;
+    static constexpr int EXTERNAL_POSE_ACCEL_BIAS_TAU_MS = 0;
+    static constexpr bool EXTERNAL_POSE_DROPOUTS = false;
+};
+using ENV_TRACKER = typename builder::ENVIRONMENT_FACTORY_POST_TRAINING<DEVICE, T, TI, OPTIONS_TRACKER>::ENVIRONMENT;
+using ENV_PREDICT = typename builder::ENVIRONMENT_FACTORY_POST_TRAINING<DEVICE, T, TI, OPTIONS_PREDICT>::ENVIRONMENT;
+// accelerometer as measured in log31 (offset 0.5-2 m/s^2 drifting, noise 2.5 m/s^2), with the firmware's offset removal
+template <int TAU_MS, bool ACCEL = true, bool DROPOUTS = false, int GAIN_PCT = 100>
+struct OPTIONS_PREDICT_REAL: OPTIONS_PREDICT{
+    static constexpr int EXTERNAL_POSE_POSITION_GAIN_PCT = GAIN_PCT;
+    static constexpr bool EXTERNAL_POSE_DROPOUTS = DROPOUTS; // camera frames lost in bursts + bad fixes (flights 2026-10-21/22)
+    static constexpr bool EXTERNAL_POSE_PREDICT_ACCEL = ACCEL;
+    static constexpr bool EXTERNAL_POSE_ACCEL_REAL = true;
+    static constexpr int EXTERNAL_POSE_ACCEL_BIAS_TAU_MS = TAU_MS;
+};
+template <int TAU_MS, bool ACCEL = true, bool DROPOUTS = false, int GAIN_PCT = 100>
+using ENV_PREDICT_REAL = typename builder::ENVIRONMENT_FACTORY_POST_TRAINING<DEVICE, T, TI, OPTIONS_PREDICT_REAL<TAU_MS, ACCEL, DROPOUTS, GAIN_PCT>>::ENVIRONMENT;
+constexpr TI N_EP = 50;
+constexpr TI N_DYNAMICS = 40;
+
+template <typename ENV>
+void run(DEVICE& device, const std::string& name, const std::string& actor_path, const std::vector<std::string>& dynamics_json, RNG& rng){
+    using EVAL_ACTOR = typename ACTOR::template CHANGE_BATCH_SIZE<TI, N_EP>::template CHANGE_CAPABILITY<rlt::nn::capability::Forward<DYNAMIC_ALLOCATION>>;
+    EVAL_ACTOR actor;
+    rlt::malloc(device, actor);
+    auto file = HighFive::File(actor_path, HighFive::File::ReadOnly);
+    rlt::load(device, actor, file.getGroup("actor"));
+    using RESULT = rlt::rl::utils::evaluation::Result<rlt::rl::utils::evaluation::Specification<T, TI, ENV, N_EP, ENV::EPISODE_STEP_LIMIT>>;
+    double crashed = 0, episodes = 0, pos_err = 0, speed = 0, n_steady = 0, ret = 0;
+    double sway2[3] = {0, 0, 0}, n_sway = 0; // spread around each episode's own mean position (what the trim cannot remove)
+    for(const auto& js: dynamics_json){
+        ENV env;
+        rlt::init(device, env);
+        typename ENV::Parameters params;
+        rlt::from_json(device, env, js, params);
+        if(std::getenv("EVAL_IMBALANCE")){
+            // the real Air75 (2026-10-23, d4-d6): front-right rotor (0) weak, battery sagging
+            for(TI r = 0; r < 4; r++){
+                for(TI j = 0; j < 3; j++){
+                    params.dynamics.rotor_thrust_coefficients[r][j] *= (r == 0 ? 0.8 : 1.0) * 0.93;
+                }
+            }
+        }
+        auto init_old = env.parameters.mdp.init; // as in helper.h sample_trajectories
+        env.parameters = params;
+        env.parameters.mdp.init = init_old;
+        rlt::sample_initial_parameters(device, env, env.parameters, rng);
+        RESULT result;
+        rlt::rl::utils::evaluation::Data<rlt::rl::utils::evaluation::DataSpecification<typename RESULT::SPEC>> data;
+        rlt::malloc(device, data);
+        rlt::rl::environments::DummyUI ui;
+        rlt::Mode<rlt::mode::Evaluation<>> mode;
+        rlt::evaluate(device, env, ui, actor, result, data, rng, mode);
+        ret += result.returns_mean;
+        for(TI ep = 0; ep < N_EP; ep++){
+            bool crash = false;
+            for(TI s = 0; s < ENV::EPISODE_STEP_LIMIT; s++){
+                if(rlt::get(device, data.terminated, ep, s)){ crash = true; break; }
+            }
+            episodes++;
+            if(crash){ crashed++; continue; }
+            // EVAL_WINDOW_START (steps, default half the episode): start of the hover window
+            const TI window_start = std::getenv("EVAL_WINDOW_START") ? std::atoi(std::getenv("EVAL_WINDOW_START")) : ENV::EPISODE_STEP_LIMIT / 2;
+            double sum[3] = {0, 0, 0}, sum2[3] = {0, 0, 0}, n_ep = 0;
+            for(TI s = window_start; s < ENV::EPISODE_STEP_LIMIT; s++){
+                const auto& st = rlt::get(device, data.states, ep, s);
+                if(st.trajectory.type != rlt::rl::environments::l2f::POSITION) break;
+                for(TI i = 0; i < 3; i++){ sum[i] += st.position[i]; sum2[i] += st.position[i] * st.position[i]; }
+                n_ep++;
+                pos_err += std::sqrt(st.position[0]*st.position[0] + st.position[1]*st.position[1] + st.position[2]*st.position[2]);
+                speed += std::sqrt(st.linear_velocity[0]*st.linear_velocity[0] + st.linear_velocity[1]*st.linear_velocity[1] + st.linear_velocity[2]*st.linear_velocity[2]);
+                n_steady++;
+            }
+            if(n_ep > 1){
+                for(TI i = 0; i < 3; i++) sway2[i] += sum2[i] / n_ep - (sum[i] / n_ep) * (sum[i] / n_ep);
+                n_sway++;
+            }
+        }
+        rlt::free(device, data);
+    }
+    std::printf("%-8s %-60s crashes %5.1f%%  return %6.1f  hover window: mean distance to target %5.1f cm, mean speed %5.1f cm/s, sway x/y/z %4.1f %4.1f %4.1f cm\n",
+        name.c_str(), actor_path.c_str(), 100 * crashed / episodes, ret / dynamics_json.size(), 100 * pos_err / n_steady, 100 * speed / n_steady,
+        100 * std::sqrt(sway2[0] / n_sway), 100 * std::sqrt(sway2[1] / n_sway), 100 * std::sqrt(sway2[2] / n_sway));
+    std::fflush(stdout);
+    rlt::free(device, actor);
+}
