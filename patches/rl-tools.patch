+    std::vector<std::string> dynamics_json;
+    for(TI i = 0; i < N_DYNAMICS && i < lines.size(); i++){
+        auto id = split_by_comma(lines[(i * lines.size()) / N_DYNAMICS])[0]; // spread over the whole range
+        std::ifstream f("./src/foundation_policy/dynamics_parameters_" + experiment + "/" + id + ".json");
+        dynamics_json.emplace_back((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    }
+    std::cout << "dynamics sets: " << dynamics_json.size() << " x " << N_EP << " episodes" << std::endl;
+    for(int a = 1; a < argc; a++){
