+// 2026-10-23: the real Air75 flies with one motor commanded ~30% above the others for the whole flight (front right,
+// d4-d6) and a battery sagging to 2.6-3.5 V. Each gathered epoch, a copy of the teacher's dynamics gets with
+// probability MOTOR_IMBALANCE_PROB one random rotor weakened to U(MOTOR_WEAK_MIN, 1) of its thrust, and all rotors
+// scaled by U(BATTERY_SAG_MIN, 1).
+constexpr bool MOTOR_IMBALANCE = true;
+constexpr T MOTOR_IMBALANCE_PROB = 0.75;
+constexpr T MOTOR_WEAK_MIN = 0.75;
+constexpr T BATTERY_SAG_MIN = 0.9;
+
+template <typename PARAMETERS>
+PARAMETERS perturb_motors(DEVICE& device, const PARAMETERS& parameters, RNG& rng){
+    PARAMETERS p = parameters;
+    if constexpr(MOTOR_IMBALANCE){
+        T sag = rlt::random::uniform_real_distribution(device.random, BATTERY_SAG_MIN, (T)1, rng);
+        TI weak = 4;
+        T weak_scale = 1;
+        if(rlt::random::uniform_real_distribution(device.random, (T)0, (T)1, rng) < MOTOR_IMBALANCE_PROB){
+            weak = rlt::random::uniform_int_distribution(device.random, (TI)0, (TI)3, rng);
+            weak_scale = rlt::random::uniform_real_distribution(device.random, MOTOR_WEAK_MIN, (T)1, rng);
+        }
+        for(TI rotor_i = 0; rotor_i < 4; rotor_i++){
+            T scale = sag * (rotor_i == weak ? weak_scale : 1);
+            for(TI j = 0; j < 3; j++){
+                p.dynamics.rotor_thrust_coefficients[rotor_i][j] *= scale;
+            }
+        }
+    }
+    return p;
+}
