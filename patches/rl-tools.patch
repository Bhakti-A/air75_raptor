+int main(int argc, char** argv){
+    DEVICE device;
+    rlt::init(device);
+    std::string experiment = "2026-09-28_17-48-14";
+    if (const char* e = std::getenv("RAPTOR_TEACHER_EXPERIMENT")) experiment = e;
