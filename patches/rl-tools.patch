+    // Position and velocity as an off-board tracker delivers them (wall-ArUco camera -> laptop -> radio):
+    // camera frames every CONFIG::CAMERA_PERIOD steps with position noise; velocity is a low-passed finite
+    // difference of those frames (time constant CONFIG::VELOCITY_TAU); then a delay sampled per episode
+    // (CONFIG::DELAY_MIN..DELAY_MAX steps) and a radio that passes a new value only every CONFIG::RADIO_PERIOD steps.
+    // Read by observation::PositionExternal / observation::LinearVelocityExternal.
+    template <typename T_T, typename T_TI, typename T_CONFIG, typename T_NEXT_COMPONENT>
+    struct StateExternalPoseSpecification{
+        using T = T_T;
+        using TI = T_TI;
+        using CONFIG = T_CONFIG;
+        using NEXT_COMPONENT = T_NEXT_COMPONENT;
+    };
+    template <typename T_SPEC>
+    struct StateExternalPose: T_SPEC::NEXT_COMPONENT{
+        using SPEC = T_SPEC;
+        using T = typename SPEC::T;
+        using TI = typename SPEC::TI;
+        using CONFIG = typename SPEC::CONFIG;
+        using NEXT_COMPONENT = typename SPEC::NEXT_COMPONENT;
+        static constexpr bool REQUIRES_INTEGRATION = false;
+        static constexpr TI DIM = NEXT_COMPONENT::DIM; // not part of the minimal state
+        static constexpr TI HISTORY_LENGTH_TRACKER = CONFIG::DELAY_MAX + CONFIG::RADIO_PERIOD + 1;
+        static constexpr TI HISTORY_LENGTH_PREDICTOR = CONFIG::ASSUMED_DELAY + CONFIG::VELOCITY_EXTRA_AGE + 2;
+        static constexpr TI HISTORY_LENGTH = HISTORY_LENGTH_TRACKER > HISTORY_LENGTH_PREDICTOR ? HISTORY_LENGTH_TRACKER : HISTORY_LENGTH_PREDICTOR;
+        T position_history[HISTORY_LENGTH][3]; // tracker output (held between camera frames), indexed by step % HISTORY_LENGTH
+        T velocity_history[HISTORY_LENGTH][3];
+        // CONFIG::PREDICT: on-board delay compensation as the firmware does it: world-frame acceleration from the
+        // accelerometer (with bias + noise) integrated forward from each (old) tracker value
+        T accel_history[HISTORY_LENGTH][3];
+        T accel_bias[3];
+        T accel_bias_estimate[3]; // CONFIG::ACCEL_BIAS_TAU > 0: the firmware's slow running mean of the measured acceleration
+        T estimated_position[3];
+        T estimated_velocity[3];
+        T camera_position[3];
+        T camera_velocity[3];
+        T noise_scale;
+        TI step;
+        TI delay;
+        TI camera_phase;
+        TI radio_phase;
+        // CONFIG::DROPOUTS (see the post-training environment.h)
+        T drop_probability, burst_start_probability, burst_end_probability, bad_fix_probability;
+        bool camera_burst;
+        TI camera_frame_step;                       // step of the last accepted camera frame
+        TI frame_step_history[HISTORY_LENGTH];      // camera_frame_step as of that step (sender side)
+        bool radio_valid;                           // what the drone sees on the radio (held between radio updates)
+        TI radio_frame_step;                        // frame step of the newest value the drone has received
+        TI radio_new_step;                          // step at which that value arrived (heartbeat change)
+        bool estimate_valid;                        // policy.cpp predictor_have_estimate
+        TI estimate_valid_step;                     // last step with a valid radio value (dead-reckoning start)
+        T radio_position[3];                        // newest value the drone has received (held between updates)
+        T radio_velocity[3];
+    };
