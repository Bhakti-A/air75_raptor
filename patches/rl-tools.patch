+        RNG rng2; rlt::malloc(device, rng2); rlt::init(device, rng2, 1);
+        run<ENV_TRACKER>(device, "tracker", argv[a], dynamics_json, rng2);
+        }
+        RNG rng3; rlt::malloc(device, rng3); rlt::init(device, rng3, 1);
+        run<ENV_PREDICT>(device, "predict", argv[a], dynamics_json, rng3);
+        if(std::getenv("EVAL_DROPOUTS")){
+            RNG r10; rlt::malloc(device, r10); rlt::init(device, r10, 1);
+            run<ENV_PREDICT_REAL<2000>>(device, "real_t2", argv[a], dynamics_json, r10);
+            RNG r11; rlt::malloc(device, r11); rlt::init(device, r11, 1);
+            run<ENV_PREDICT_REAL<2000, true, true>>(device, "dropout", argv[a], dynamics_json, r11);
+        }
+        if(std::getenv("EVAL_GAINS")){
+            RNG g1; rlt::malloc(device, g1); rlt::init(device, g1, 1);
+            run<ENV_PREDICT_REAL<2000, true, true, 100>>(device, "gain100", argv[a], dynamics_json, g1);
+            RNG g2; rlt::malloc(device, g2); rlt::init(device, g2, 1);
+            run<ENV_PREDICT_REAL<2000, true, true, 80>>(device, "gain80", argv[a], dynamics_json, g2);
+            RNG g3; rlt::malloc(device, g3); rlt::init(device, g3, 1);
+            run<ENV_PREDICT_REAL<2000, true, true, 60>>(device, "gain60", argv[a], dynamics_json, g3);
+            RNG g4; rlt::malloc(device, g4); rlt::init(device, g4, 1);
+            run<ENV_PREDICT_REAL<2000, true, true, 40>>(device, "gain40", argv[a], dynamics_json, g4);
+        }
+        if(std::getenv("EVAL_REAL_ACCEL")){
+            RNG r4; rlt::malloc(device, r4); rlt::init(device, r4, 1);
+            run<ENV_PREDICT_REAL<0>>(device, "real", argv[a], dynamics_json, r4);
+            RNG r5; rlt::malloc(device, r5); rlt::init(device, r5, 1);
+            run<ENV_PREDICT_REAL<1000>>(device, "real_t1", argv[a], dynamics_json, r5);
+            RNG r6; rlt::malloc(device, r6); rlt::init(device, r6, 1);
+            run<ENV_PREDICT_REAL<2000>>(device, "real_t2", argv[a], dynamics_json, r6);
+            RNG r8; rlt::malloc(device, r8); rlt::init(device, r8, 1);
+            run<ENV_PREDICT_REAL<4000>>(device, "real_t4", argv[a], dynamics_json, r8);
+            RNG r9; rlt::malloc(device, r9); rlt::init(device, r9, 1);
+            run<ENV_PREDICT_REAL<8000>>(device, "real_t8", argv[a], dynamics_json, r9);
+            RNG r7; rlt::malloc(device, r7); rlt::init(device, r7, 1);
+            run<ENV_PREDICT_REAL<0, false>>(device, "vel_only", argv[a], dynamics_json, r7);
+        }
+    }
+}
