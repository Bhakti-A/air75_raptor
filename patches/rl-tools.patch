+// Compares policies in the simulator with perfect position/velocity and with the wall-ArUco tracker model
+// (StateExternalPose: delayed, 20 Hz, noisy, low-passed velocity), on the teachers' dynamics.
+// usage: eval_external_pose <checkpoint.h5> [<checkpoint.h5> ...]   (run in the post-training run folder)
+struct OPTIONS_PERFECT: OPTIONS_POST_TRAINING{
+    static constexpr bool EXTERNAL_POSE_PREDICT = false;
+    static constexpr bool EXTERNAL_POSE = false;
+    static constexpr bool EXTERNAL_POSE_DROPOUTS = false;
